    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train LaBo asso opt",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": true,
            "cwd": "/data/hqvo3/codes/LaBo",
            "env": {"CUDA_VISIBLE_DEVICES":"6"},
            "args": [
                "--cfg",
                "cfg/asso_opt/GlomCrawl/GlomCrawl_allshot_fac.py",
                "--work-dir",
                "exp/asso_opt/GlomCrawl/GlomCrawl_allshot_fac",
                "--func",
                "asso_opt_main",
            ]
        },
        {
            "name": "Train LaBo concept trans",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": true,
            "cwd": "/data/hqvo3/codes/LaBo",
            "env": {"CUDA_VISIBLE_DEVICES":"1",
                    "PYTHONPATH":"${PYTHONPATH}:/data/hqvo3/codes/CONCH"},
            "args": [
                "--cfg",
                "cfg/asso_opt/GlomCrawl/GlomCrawl_allshot_fac_wo_wb.py",
                "--work-dir",
                "exp/asso_opt/GlomCrawl/GlomCrawl_allshot_fac_debug",
                "--func",
                "concept_trans_main",
            ]
        },
        {
            "name": "Test LaBo concept trans",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": true,
            "cwd": "/data/hqvo3/codes/LaBo",
            "env": {"CUDA_VISIBLE_DEVICES":"1",
                    "PYTHONPATH":"${PYTHONPATH}:/data/hqvo3/codes/CONCH"},
            "args": [
                "--cfg",
                "cfg/asso_opt/GlomCrawl/GlomCrawl_allshot_fac_wo_wb.py",
                "--func",
                "concept_trans_main", 
                "--test",
                "--cfg-options", 
                "bs=1024",
                "ckpt_path='/data/hqvo3/codes/LaBo/exp/asso_opt/GlomCrawl/GlomCrawl_allshot_fac/epoch=749-step=11250-val_acc=0.3636.ckpt'",
            ]
        }
    ]
}